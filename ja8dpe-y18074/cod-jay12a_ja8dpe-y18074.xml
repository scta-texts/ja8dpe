      <div xml:id="ja8dpe-y18074"><!-- dpe-q3c7 -->
        <head xml:id="ja8dpe-y18074-Hd1e101">Caput 7</head>
        <head xml:id="ja8dpe-y18074-Hd1e103" type="question-title">Sane licet</head>
        <p xml:id="ja8dpe-y18074-d1e106">
          <lb ed="#C" n="55"/>¶ Septimum cap. Sane licet. 
        </p>
        <p xml:id="ja8dpe-y18074-d1e111">
          <lb ed="#C" n="56"/>IN Hoc SEPTIMO 
          <lb ed="#C" n="57"/>capite vult dicere doctor 
          <lb ed="#C" n="58"/>quod quis supradicta de 
          op<lb ed="#C" n="59" break="no"/>timo pricipatu sint vera 
          <lb ed="#C" n="60"/>tam de principatu vniuersa 
          <lb ed="#C" n="61"/>li quam particulari: 
          regulari<lb ed="#C" n="62" break="no"/>ter nihilominus ille 
          princi<lb ed="#C" n="63" break="no"/>patus regalis in casu non esset optimus: immo 
          <lb ed="#C" n="64"/>mutandus in aristocraticum: vel tymocraticum. 
          <lb ed="#C" n="65"/>Patet in casu quo principans esset tyrainus: 
          <lb ed="#C" n="66"/>vel quando plures aspirarent ad 
          principan<lb ed="#C" n="67" break="no"/>dum &amp; melius seruaretur bonum 
          commu<lb ed="#C" n="68" break="no"/>ne per plures principantes. ideo casualiter 
          <lb ed="#C" n="69"/>alius principatus potest esse melior quam regius 
          <lb ed="#C" n="70"/>dummodo semper seruetur prima 
          condi<lb ed="#C" n="71" break="no"/>tio necessario requisita ad bonum 
          principa<lb ed="#C" n="72" break="no"/>tum: puta quod sit propter bonum commune. 
          <lb ed="#C" n="73"/>Et secunda conditio: puta quod vnus 
          principe<lb ed="#C" n="74" break="no"/>tur: casualiter potest esse falsa: puta si ille 
          vni<lb ed="#C" n="75" break="no"/>cus adtyrannisandum aspiraret &amp; declinaret 
          <lb ed="#C" n="76"/>tunc optimus principatus non esset 
          simpli<lb ed="#C" n="77" break="no"/>citer omnibus optimus: immo multis esset no 
          <lb ed="#C" n="78"/>ciuus quemadmodum declarat doctor in 
          <lb ed="#C" n="79"/>presenti capite. reliqua autem que dicit 
          cla<lb ed="#C" n="80" break="no"/>ra sunt: quare transeo ad aliud in quo 
          sol<lb ed="#C" n="81" break="no"/>uuntur rationes probantes quod debet esse vnus 
          <lb ed="#C" n="82"/>supremus principans &amp; estt 
        </p>
